<file path="src/app/api/chat/route.ts">
import { NextResponse } from "next/server";
import OpenAI from "openai";



type ChatBody = {
  message?: string;
  caseId?: string | number;
  caseData?: {
    patient_name: string | null;
    patient_amka: string | null;
    patient_phone: string | null;
  };
  history?: Array<{ role: "user" | "assistant"; content: string }>;
};

export async function POST(req: Request) {
  try {
    const apiKey = process.env.OPENAI_API_KEY;
    if (!apiKey) {
      return NextResponse.json(
        { error: "Missing OPENAI_API_KEY on server." },
        { status: 500 }
      );
    }

    const body = (await req.json()) as ChatBody;
    const message = (body?.message || "").trim();

    if (!message) {
      return NextResponse.json(
        { error: "Missing 'message' in request body." },
        { status: 400 }
      );
    }

    // Check if user is asking about the creator
    const creatorKeywords = [
      "ποιος σε έφτιαξε",
      "ποιος είναι ο δημιουργός",
      "ποιος σε δημιούργησε",
      "ποιος σε ανέπτυξε",
      "who made you",
      "who created you",
      "who is your creator",
      "δημιουργός",
      "κτίστης",
    ];

    const lowerMessage = message.toLowerCase();
    const isCreatorQuestion = creatorKeywords.some((keyword) =>
      lowerMessage.includes(keyword)
    );

    if (isCreatorQuestion) {
      const creatorReply =
        "Το ClinicScribe αναπτύχθηκε από τον Βασίλης Πετρούλιας. Όλα τα πνευματικά δικαιώματα ανήκουν στον Βασίλη Πετρούλια. Για περισσότερες πληροφορίες: Τηλ: 6947930375";
      return NextResponse.json({ reply: creatorReply });
    }

   const client = new OpenAI({ apiKey });

    // Triage: check if question is app-related, case-related, or medical
    const triageResp = await client.responses.create({
      model: "gpt-6.1-sol",
      input: [
        {
          role: "system",
          content:
            "Είσαι ένας ταξινομητής. Απάντησε ΜΟΝΟ με 'ALLOWED' ή 'BLOCKED'. Απάντησε 'ALLOWED' αν η ερώτηση είναι: (1) χαιρετισμός/ευχαριστία/ευγένεια (π.χ. 'καλημέρα', 'καλησπέρα', 'γεια', 'ευχαριστώ'), (2) σχετική με τη χρήση της εφαρμογής (π.χ. 'πώς κάνω εξαγωγή;', 'ποιος είσαι;', 'πώς λειτουργείς;'), (3) σχετική με ασθενή/case (π.χ. ονόματα ασθενών, ημερομηνίες, υπενθυμίσεις), ή (4) ιατρική (γνωματεύσεις, κλινικά ευρήματα, διάγνωση, θεραπεία, συμπτώματα). Απάντησε 'BLOCKED' αν είναι ιστορία, πολιτικά, αθλητικά, τραγούδια, ή άλλα άσχετα.",
        },
        { role: "user", content: message },
      ],
    });

    const triageResult = (triageResp.output_text?.trim() || "").toUpperCase();

    if (triageResult.includes("BLOCKED")) {
      const blockedReply =
        "Το ClinicScribe έχει σχεδιαστεί αποκλειστικά για ιατρικές γνωματεύσεις και βοήθεια στη σύνταξη ιατρικών κειμένων. Δεν μπορώ να απαντήσω σε ερωτήσεις εκτός του σκοπού της εφαρμογής. Παρακαλώ θέσε μια ιατρική ερώτηση, ρώτησε κάτι σχετικό με τη χρήση της εφαρμογής, ή περιέγραψε τα κλινικά ευρήματα.";
      return NextResponse.json({ reply: blockedReply });
    }

        // Use conversation history from frontend
    const conversationHistory = (body.history || []) as Array<{ role: "user" | "assistant"; content: string }>;
    console.log("conversation history count=", conversationHistory.length);


    const caseInfo = body.caseData
  ? `\n\nΣτοιχεία ασθενούς:\n- Όνομα: ${body.caseData.patient_name || "—"}\n- ΑΜΚΑ: ${body.caseData.patient_amka || "—"}\n- Τηλέφωνο: ${body.caseData.patient_phone || "—"}`
  : "";

const resp = await client.responses.create({
  model: "gpt-6.1-sol",
  input: [
    {
      role: "system",
      content:
        "Είσαι ο ClinicScribe, βοηθός ιατρού. Απαντάς στα Ελληνικά, με επαγγελματικό και ευγενικό ύφος.\n\nΚανόνες:\n1) Αν ο χρήστης πει χαιρετισμό/ευχαριστώ (π.χ. «καλημέρα», «καλησπέρα», «γεία», «ευχαριστώ»), απάντησε ευγενικά και σύντομα και ρώτα πώς μπορείς να βοηθήσεις.\n2) Για ιατρικά αιτήματα: γράφε καθαρά, δομημένα, και ζήτα διευκρινίσεις όταν λείπουν κρίσιμα στοιχεία. Αν υπάρχουν στοιχεία ασθενούς, περιλάμβανέ τα στην αρχή της γνωμάτευσης.\n3) Δεν αντικαθιστάς ιατρική κρίση — ο ιατρός ελέγχει και υπογράφει." + caseInfo,
    },
    ...conversationHistory,
    { role: "user", content: message },
  ],
});


    const reply =
      resp.output_text?.trim() ||
      "Δεν μπόρεσα να δημιουργήσω απάντηση αυτή τη στιγμή.";

    return NextResponse.json({ reply });
  } catch (err: any) {
    const msg =
      typeof err?.message === "string" ? err.message : "Unknown error";
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
</file>

<file path="src/app/app/page.tsx">
"use client";

import "./app.css";
import { useEffect, useMemo, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { createSupabaseBrowserClient } from "../../lib/supabase/client";

type ChatRole = "user" | "assistant";

type ChatMessage = {
  id: string;
  role: ChatRole;
  text: string;
  time: string;
  showExportHint?: boolean;
};

type CaseItem = {
  id: string;
  patientName: string;
  dateLabel: string;
};

export default function Page() {
  const router = useRouter();
  const supabase = useMemo(() => createSupabaseBrowserClient(), []);

  const [userEmail, setUserEmail] = useState<string>("");
  const [userName, setUserName] = useState<string>("");
  const [userAvatarUrl, setUserAvatarUrl] = useState<string>("");
  const [isUserMenuOpen, setIsUserMenuOpen] = useState<boolean>(false);
  const userMenuRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    let isMounted = true;

    (async () => {
      const { data } = await supabase.auth.getUser();
      const u = data.user;

      if (!isMounted) return;

      const meta: any = u?.user_metadata ?? {};
      setUserEmail(u?.email ?? "");
      setUserName(meta?.full_name ?? meta?.name ?? "");
      setUserAvatarUrl(meta?.avatar_url ?? meta?.picture ?? "");
    })();

    const onDocClick = (e: MouseEvent) => {
      if (!userMenuRef.current) return;
      if (!userMenuRef.current.contains(e.target as Node)) {
        setIsUserMenuOpen(false);
      }
    };

    document.addEventListener("mousedown", onDocClick);
    return () => {
      isMounted = false;
      document.removeEventListener("mousedown", onDocClick);
    };
  }, [supabase]);

  const initials = useMemo(() => {
    const base = (userName || userEmail || "U").trim();
    const parts = base.split(/\s+/).filter(Boolean);
    const a = parts[0]?.[0] ?? "U";
    const b = parts.length > 1 ? parts[parts.length - 1][0] : "";
    return (a + b).toUpperCase();
  }, [userName, userEmail]);

  const handleLogout = async () => {
    await supabase.auth.signOut();
    router.push("/signin");
    router.refresh();
  };

  type DbCase = {
    id: number;
    case_type: string;
    patient_name: string | null;
    patient_amka: string | null;
    patient_phone: string | null;
    title: string;
    created_at: string;
  };

  const [cases, setCases] = useState<CaseItem[]>([]);
  const [loadingCases, setLoadingCases] = useState(true);

  useEffect(() => {
    const loadCases = async () => {
      try {
        const { data, error } = await supabase
          .from("cases")
          .select("id, case_type, patient_name, patient_amka, patient_phone, title, created_at")
          .order("case_type", { ascending: true }) // general πρώτο
          .order("created_at", { ascending: false }); // μετά ανά ημερομηνία

        if (error) throw error;

        const formatted = (data as DbCase[]).map((c) => ({
          id: String(c.id),
          patientName: c.title || c.patient_name || "Χωρίς όνομα",
          dateLabel: new Date(c.created_at).toLocaleDateString("el-GR"),
        }));

        setCases(formatted);

// Set active case to general (first one)
if (formatted.length > 0) {
  setActiveCaseId(formatted[0].id);

  const activeCase = (data as DbCase[]).find(
    (c) => String(c.id) === formatted[0].id
  );

  if (activeCase) {
    setActiveCaseData(activeCase);
  }
}
      } catch (e: any) {
        console.error("Error loading cases:", e);
      } finally {
        setLoadingCases(false);
      }
    };


    loadCases();
  }, [supabase]);

  const [activeCaseId, setActiveCaseId] = useState<string | null>(null);
  const [activeCaseData, setActiveCaseData] = useState<DbCase | null>(null);

  const [input, setInput] = useState<string>("");
  const [isSidebarOpen, setIsSidebarOpen] = useState<boolean>(false);
  const [isSending, setIsSending] = useState<boolean>(false);

  // Case action states
  const [caseActionMenuId, setCaseActionMenuId] = useState<string | null>(null);
  const [renameModalCaseId, setRenameModalCaseId] = useState<string | null>(null);
  const [renameInputValue, setRenameInputValue] = useState<string>("");
  const [isRenamingLoading, setIsRenamingLoading] = useState<boolean>(false);
  const [deleteConfirmCaseId, setDeleteConfirmCaseId] = useState<string | null>(null);
  const [isDeletingLoading, setIsDeletingLoading] = useState<boolean>(false);

  const [isRecording, setIsRecording] = useState<boolean>(false);
  const [isTranscribing, setIsTranscribing] = useState<boolean>(false);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);
  const chunksRef = useRef<BlobPart[]>([]);

  const chatEndRef = useRef<HTMLDivElement | null>(null);
  const lastAssistantRef = useRef<HTMLDivElement | null>(null);
  const textareaRef = useRef<HTMLTextAreaElement | null>(null);

  // Auto-resize textarea based on content
  const resizeTextarea = () => {
    const ta = textareaRef.current;
    if (!ta) return;
    // Reset height to auto to get the correct scrollHeight
    ta.style.height = "auto";
    // Set height to scrollHeight, capped at max-height
    const maxHeight = 260; // max-height in px
    const newHeight = Math.min(ta.scrollHeight, maxHeight);
    ta.style.height = newHeight + "px";
  };

  // Trigger resize when input changes
  useEffect(() => {
    resizeTextarea();
  }, [input]);

  const scrollToBottom = (
  behavior: ScrollBehavior = "smooth",
  block: ScrollLogicalPosition = "end"
) => {
  // Προτεραιότητα: τελευταίο assistant bubble
  if (lastAssistantRef.current) {
    lastAssistantRef.current.scrollIntoView({ behavior, block });
    return;
  }
  chatEndRef.current?.scrollIntoView({ behavior, block });
};


  const nowTime = () => {
    const d = new Date();
    return d.toLocaleTimeString("el-GR", { hour: "2-digit", minute: "2-digit" });
  };

  const startRecording = async () => {
    if (isRecording || isTranscribing) return;

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });

      chunksRef.current = [];
      
      // ✅ NEW: Try supported mimeTypes in order
      let mimeType = "audio/webm";
      const supportedMimeTypes = [
        "audio/webm;codecs=opus",
        "audio/webm",
        "audio/mp4",
        "audio/wav",
        "audio/ogg",
      ];
      
      for (const mime of supportedMimeTypes) {
        if (MediaRecorder.isTypeSupported(mime)) {
          mimeType = mime;
          break;
        }
      }
      
      console.log("[startRecording] Using mimeType:", mimeType);
      
      const mr = new MediaRecorder(stream, { mimeType });
      mediaRecorderRef.current = mr;

      mr.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) chunksRef.current.push(e.data);
      };

      mr.onstop = async () => {
        // σταμάτα τα tracks για να κλείσει το mic indicator
        stream.getTracks().forEach((t) => t.stop());

        const blob = new Blob(chunksRef.current, { type: mr.mimeType || "audio/webm" });
        chunksRef.current = [];

        if (blob.size < 1000) return; // πολύ μικρό/άδειο

        setIsTranscribing(true);
        try {
          const fd = new FormData();
          const mimeType = blob.type || "audio/webm";

const ext =
  mimeType.includes("mp4") ? "mp4" :
  mimeType.includes("mpeg") ? "mp3" :
  mimeType.includes("wav") ? "wav" :
  mimeType.includes("ogg") ? "ogg" :
  mimeType.includes("webm") ? "webm" :
  "webm";

const file = new File([blob], `audio.${ext}`, {
  type: mimeType,
});
fd.append("file", file);


          const r = await fetch("/api/transcribe", { method: "POST", body: fd });
          const data = await r.json();

          if (!r.ok) throw new Error(data?.error || "Σφάλμα μεταγραφής.");

          const t = String(data?.text || "").trim();
          if (t) {
            setInput((prev) => {
              const base = prev.trim();
              return base ? base + " " + t : t;
            });
          }
        } catch (e: any) {
          alert("Αποτυχία μεταγραφής. " + (e?.message ? `(${e.message})` : ""));
        } finally {
          setIsTranscribing(false);
        }
      };

      mr.start();
      setIsRecording(true);
    } catch (e: any) {
      alert("Δεν δόθηκε πρόσβαση στο μικρόφωνο ή δεν υποστηρίζεται. " + (e?.message ? `(${e.message})` : ""));
    }
  };

  const stopRecording = () => {
    if (!mediaRecorderRef.current) return;
    try {
      mediaRecorderRef.current.stop();
    } catch {}
    setIsRecording(false);
  };

  const [messages, setMessages] = useState<ChatMessage[]>([]);

  // Load messages when active case changes
  useEffect(() => {
    if (!activeCaseId) return;

    const loadMessages = async () => {
      try {
        const { data, error } = await supabase
          .from("messages")
          .select("id, role, text, created_at")
          .eq("case_id", parseInt(activeCaseId))
          .order("created_at", { ascending: true });

        if (error) throw error;

        const formatted = (data as any[]).map((m) => ({
          id: m.id.toString(),
          role: m.role as ChatRole,
          text: m.text,
          time: new Date(m.created_at).toLocaleTimeString("el-GR", {
            hour: "2-digit",
            minute: "2-digit",
          }),
        }));

        setMessages(formatted);
      } catch (e: any) {
        console.error("Error loading messages:", e);
      }
    };

    loadMessages();
  }, [activeCaseId, supabase]);

  // Load case data when active case changes
  useEffect(() => {
    if (!activeCaseId) {
      setActiveCaseData(null);
      return;
    }

    const caseFromList = cases.find((c) => c.id === activeCaseId);
    if (!caseFromList) return;

    // Find the full case data from loaded cases
    const loadCaseData = async () => {
      try {
        const { data, error } = await supabase
          .from("cases")
          .select("id, case_type, patient_name, patient_amka, patient_phone, title, created_at")
          .eq("id", parseInt(activeCaseId))
          .single();

        if (error) throw error;
        if (data) {
          setActiveCaseData(data as DbCase);
        }
      } catch (e: any) {
        console.error("Error loading case data:", e);
      }
    };

    loadCaseData();
  }, [activeCaseId, supabase, cases]);

  useEffect(() => {
  const last = messages[messages.length - 1];
  if (last?.role === "assistant") {
    // περιμένουμε 1 frame για να έχει γίνει render το ref
    requestAnimationFrame(() => {
      scrollToBottom("smooth", "start");
    });
  }
}, [messages]);


  const handleSend = async () => {
    const text = input.trim();
    if (!text || isSending || !activeCaseId) return;

    // If user asks for export/word, don't call the AI. Just show hint and auto-download.
    const exportKeywords = ["word", "export", "κατέβασμα", "εξαγωγή", "docx"];
    const askedForExport = exportKeywords.some((kw) =>
      text.toLowerCase().includes(kw)
    );

    if (askedForExport) {
      setMessages((prev) => [
        ...prev,
        {
          id: `hint-${Date.now()}`,
          role: "assistant",
          text: "Η γνωμάτευση έχει κατεβεί. Θα την βρεις στο φάκελο Downloads.",
          time: nowTime(),
          showExportHint: true,
        },
      ]);
      setInput("");
      await exportWord();
      return;
    }

    setInput("");
    setIsSending(true);

    try {
      // 1) Insert user message to DB
      const { data: userRow, error: userErr } = await supabase
        .from("messages")
        .insert([
          {
            case_id: parseInt(activeCaseId),
            role: "user",
            text,
          },
        ])
        .select("id, role, text, created_at")
        .single();

      if (userErr) throw userErr;

      // Update UI immediately
      setMessages((prev) => [
        ...prev,
      
        {
          id: userRow.id.toString(),
          role: "user",
          text: userRow.text,
          time: new Date(userRow.created_at).toLocaleTimeString("el-GR", {
            hour: "2-digit",
            minute: "2-digit",
          }),
        },
      ]);

      const r = await fetch("/api/chat", {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify({
    message: text,
    caseId: activeCaseId,
    caseData: activeCaseData,
    history: messages
      .filter((m) => !m.showExportHint)
      .slice(-12)
      .map((m) => ({ role: m.role, content: m.text })),
  }),
});


      const data = await r.json();

      if (!r.ok) {
        throw new Error(data?.error || "Σφάλμα επικοινωνίας με τον server.");
      }

      const replyText = String(data?.reply || "").trim();

      // 3) Insert assistant message to DB
      const { data: aRow, error: aErr } = await supabase
        .from("messages")
        .insert([
          {
            case_id: parseInt(activeCaseId),
            role: "assistant",
            text: replyText || "—",
          },
        ])
        .select("id, role, text, created_at")
        .single();

      if (aErr) throw aErr;

      setMessages((prev) => [
        ...prev,
        {
          id: aRow.id.toString(),
          role: "assistant",
          text: aRow.text,
          time: new Date(aRow.created_at).toLocaleTimeString("el-GR", {
            hour: "2-digit",
            minute: "2-digit",
          }),
        },
      ]);

    } catch (e: any) {
      console.error(e);
      alert("Σφάλμα αποστολής. " + (e?.message ? `(${e.message})` : ""));
    } finally {
      setIsSending(false);
    }
  };


  const handleClearChat = async () => {
  if (!activeCaseId) return;

  const ok = confirm("Θέλεις σίγουρα να διαγράψεις ΟΛΑ τα μηνύματα αυτής της συνομιλίας;");
  if (!ok) return;

  try {
    const { error } = await supabase
      .from("messages")
      .delete()
      .eq("case_id", parseInt(activeCaseId));

    if (error) throw error;

    setMessages([]);

    // Re-fetch to confirm deletion from DB
    const { data, error: refetchError } = await supabase
      .from("messages")
      .select("id, role, text, created_at")
      .eq("case_id", parseInt(activeCaseId))
      .order("created_at", { ascending: true });

    if (refetchError) throw refetchError;

    setMessages([]);
  } catch (e: any) {
    console.error(e);
    alert("Αποτυχία καθαρισμού συνομιλίας. " + (e?.message ? `(${e.message})` : ""));
  }
};

// Rename case handler
const handleRenameCase = async (caseId: string, newTitle: string) => {
  const trimmed = newTitle.trim();
  if (!trimmed) {
    alert("Το όνομα δεν μπορεί να είναι κενό.");
    return;
  }

  if (trimmed.length > 80) {
    alert("Το όνομα δεν πρέπει να ξεπερνά 80 χαρακτήρες.");
    return;
  }

  setIsRenamingLoading(true);
  try {
    const { data: userData } = await supabase.auth.getUser();
    if (!userData?.user?.id) {
      alert("Σφάλμα αυθεντικοποίησης.");
      return;
    }

    const authToken = (await supabase.auth.getSession())?.data?.session?.access_token;
    if (!authToken) {
      alert("Σφάλμα αυθεντικοποίησης.");
      return;
    }

    const res = await fetch("/api/case/update-title", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${authToken}`,
      },
      body: JSON.stringify({
        caseId: parseInt(caseId),
        newTitle: trimmed,
      }),
    });

    if (!res.ok) {
      throw new Error(caseApiErrorMessage(res.status, "μετονομασίας"));
    }

    // Update local state
    setCases((prev) =>
      prev.map((c) =>
        c.id === caseId ? { ...c, patientName: trimmed } : c
      )
    );

    setRenameModalCaseId(null);
    setRenameInputValue("");
  } catch (e: any) {
    console.error("Error renaming case:", e);
    alert(e?.message || "Αποτυχία μετονομασίας. Προσπάθησε ξανά αργότερα.");
  } finally {
    setIsRenamingLoading(false);
  }
};

const caseApiErrorMessage = (status: number, action: string) => {
  if (status === 401) return "Η συνεδρία έληξε. Συνδέσου ξανά.";
  if (status === 404) return "Το case δεν βρέθηκε ή δεν έχεις πρόσβαση.";
  return `Αποτυχία ${action}. Προσπάθησε ξανά αργότερα.`;
};

// Delete case handler
const handleDeleteCase = async (caseId: string) => {
  setIsDeletingLoading(true);
  try {
    const { data: userData } = await supabase.auth.getUser();
    if (!userData?.user?.id) {
      alert("Σφάλμα αυθεντικοποίησης.");
      return;
    }

    const authToken = (await supabase.auth.getSession())?.data?.session?.access_token;
    if (!authToken) {
      alert("Σφάλμα αυθεντικοποίησης.");
      return;
    }

    const res = await fetch("/api/case/delete", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${authToken}`,
      },
      body: JSON.stringify({ caseId: parseInt(caseId) }),
    });

    if (!res.ok) {
      throw new Error(caseApiErrorMessage(res.status, "διαγραφής"));
    }

    // Update local state
    const newCases = cases.filter((c) => c.id !== caseId);
    setCases(newCases);

    // If the deleted case was active, switch to next available
    if (activeCaseId === caseId) {
      if (newCases.length > 0) {
        setActiveCaseId(newCases[0].id);
        // Load the new case data (simplified, actual case data fetch would happen)
      } else {
        setActiveCaseId(null);
        setActiveCaseData(null);
        setMessages([]);
      }
    }

    setDeleteConfirmCaseId(null);
  } catch (e: any) {
    console.error("Error deleting case:", e);
    alert(e?.message || "Αποτυχία διαγραφής. Προσπάθησε ξανά αργότερα.");
  } finally {
    setIsDeletingLoading(false);
  }
};

const exportWord = async () => {    if (!activeCaseId) {
      alert("Δεν υπάρχει ενεργό case.");
      return;
    }

    const lastAssistant = [...messages]
  .reverse()
  .find((m) => m.role === "assistant" && !m.showExportHint);
    const text = (lastAssistant?.text || "").trim();

    if (!text) {
      alert("Δεν υπάρχει απάντηση βοηθού για εξαγωγή.");
      return;
    }

    try {
      const r = await fetch("/api/export-docx", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          text,
          fileName: "gnomatefsi",
        }),
      });

      if (!r.ok) {
        const data = await r.json().catch(() => ({}));
        throw new Error(data?.error || "Αποτυχία δημιουργίας Word.");
      }

      const blob = await r.blob();
      const url = URL.createObjectURL(blob);

      const a = document.createElement("a");
      a.href = url;
      a.download = "gnomatefsi.docx";
      document.body.appendChild(a);
      a.click();
      a.remove();

      URL.revokeObjectURL(url);
    } catch (e: any) {
      alert("Δεν μπόρεσα να κατεβάσω Word. " + (e?.message ? `(${e.message})` : ""));
    }
  };

  
  return (
    <main className="cs-app">
