  .cs-app .cs-app__brand{
    min-height: 60px !important;
  }

  .cs-app .cs-app__brandLogo{
    width: 150px !important;
    height: 42px !important;
  }
}

/* === Drawer brand header: never hide on narrow widths === */
@media (max-width: 920px){
  .cs-app .cs-app__sidebar{
    padding-top: max(64px, env(safe-area-inset-top)) !important; /* χώρος για το X */
  }

  .cs-app .cs-app__drawerClose{
    z-index: 2000 !important;
  }

  .cs-app .cs-app__brand{
    position: relative !important;
    z-index: 1500 !important;
    min-height: 74px !important;
    padding: 14px 10px 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: visible !important;
  }

  .cs-app .cs-app__brandLogo{
    width: min(240px, 72vw) !important;
    height: 60px !important;
    max-height: 60px !important;
    display: block !important;
    object-fit: contain !important;
  }
}

/* extra narrow phones */
@media (max-width: 480px){
  .cs-app .cs-app__brand{
    min-height: 68px !important;
    padding: 12px 10px 8px !important;
  }

  .cs-app .cs-app__brandLogo{
    width: min(220px, 78vw) !important;
    height: 56px !important;
    max-height: 56px !important;
  }
}
/* === Desktop sidebar logo (always visible) === */
@media (min-width: 921px){
  .cs-app .cs-app__brand{
    min-height: 74px !important;
    padding: 14px 10px 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: visible !important;
  }

  .cs-app .cs-app__brandLogo{
