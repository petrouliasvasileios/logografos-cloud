              </button>
              <button
                type="button"
                className="cs-app__dialogBtn cs-app__dialogBtn--danger"
                onClick={() => handleDeleteCase(deleteConfirmCaseId)}
                disabled={isDeletingLoading}
              >
                {isDeletingLoading ? "…" : "Διαγραφή"}
              </button>
            </div>
          </div>
        </div>
      )}

    </main>
  );
}
