      {/* Delete Confirmation Modal */}
      {deleteConfirmCaseId && (
        <div className="cs-app__dialogOverlay" onClick={() => setDeleteConfirmCaseId(null)}>
          <div className="cs-app__dialog" onClick={(e) => e.stopPropagation()}>
