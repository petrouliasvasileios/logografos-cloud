        </button>

        <div className="cs-app__brand">
          <img
            className="cs-app__brandLogo"
            src="/ClinicScribe-logo.svg"
            alt="ClinicScribe"
            loading="eager"
          />
        </div>

        <button
          className="cs-app__newBtn"
          type="button"
          onClick={() => router.push("/new-case")}
        >
          + Νέα γνωμάτευση
        </button>

        <div className="cs-app__sectionTitle">Ιστορικό</div>

        <nav className="cs-app__caseList" aria-label="Ιστορικό γνωματεύσεων">
          {cases.map((c) => (
            <div
              key={c.id}
              className="cs-app__caseItemWrapper"
              onMouseLeave={() => setCaseActionMenuId(null)}
            >
              <button
                type="button"
                className={
                  "cs-app__caseItem" + (c.id === activeCaseId ? " is-active" : "")
                }
                onClick={() => {
                  setActiveCaseId(c.id);
                  setIsSidebarOpen(false);
                }}
              >
                <div className="cs-app__caseName">{c.patientName}</div>
                <div className="cs-app__caseMeta">{c.dateLabel}</div>
              </button>

              <button
                type="button"
                className="cs-app__caseActionBtn"
                aria-label={`Μενού ενεργειών για ${c.patientName}`}
                onClick={() => setCaseActionMenuId(caseActionMenuId === c.id ? null : c.id)}
              >
                ⋯
              </button>

              {caseActionMenuId === c.id && (
                <div className="cs-app__caseActionMenu" role="menu">
                  <button
                    type="button"
                    className="cs-app__caseActionItem"
                    role="menuitem"
                    onClick={() => {
                      setRenameModalCaseId(c.id);
                      setRenameInputValue(c.patientName);
                      setCaseActionMenuId(null);
                    }}
                  >
                    ✎ Μετονομασία
                  </button>
                  <button
                    type="button"
                    className="cs-app__caseActionItem cs-app__caseActionItem--danger"
                    role="menuitem"
                    onClick={() => {
                      setDeleteConfirmCaseId(c.id);
                      setCaseActionMenuId(null);
                    }}
                  >
                    🗑 Διαγραφή
                  </button>
                </div>
              )}
            </div>
          ))}
        </nav>

        <div className="cs-app__sidebarFooter">
          <img
            className="cs-app__netwind"
            src="/logo-2026-netwind.svg"
            alt="NetWind"
            loading="lazy"
          />
        </div>
      </aside>

      <section className="cs-app__main" aria-label="Συνομιλία">
        <header className="cs-app__topbar">
          <div className="cs-app__topbarLeft">
            <button
              className="cs-app__hamburger"
