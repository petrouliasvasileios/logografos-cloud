    display: block !important;
    object-fit: contain !important;
  }
}

/* ================================ */
/* Rename & Delete Dialogs */
/* ================================ */

.cs-app__dialogOverlay{
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(2, 6, 23, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.cs-app__dialog{
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 20px 40px rgba(2, 6, 23, 0.20);
  max-width: 420px;
  width: 90%;
  padding: 24px;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(16px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.cs-app__dialogTitle{
  font-size: 16px;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 12px;
}

.cs-app__dialogMessage{
  font-size: 14px;
  color: rgba(15, 23, 42, 0.75);
  margin: 0 0 20px;
  line-height: 1.45;
}

.cs-app__dialogInput{
  width: 100%;
  padding: 10px 12px;
  font-size: 14px;
  border: 1px solid rgba(15, 23, 42, 0.12);
  border-radius: 8px;
  background: #ffffff;
  color: #0f172a;
  margin-bottom: 20px;
  font-family: inherit;
}

.cs-app__dialogInput:focus{
  outline: none;
  border-color: rgba(14, 90, 115, 0.40);
  box-shadow: 0 0 0 3px rgba(14, 90, 115, 0.10);
}

.cs-app__dialogActions{
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.cs-app__dialogBtn{
  padding: 10px 16px;
  border-radius: 8px;
  border: none;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.cs-app__dialogBtn:disabled{
  opacity: 0.6;
  cursor: not-allowed;
}

.cs-app__dialogBtn--cancel{
  background: rgba(15, 23, 42, 0.08);
  color: #0f172a;
}

.cs-app__dialogBtn--cancel:hover:not(:disabled){
  background: rgba(15, 23, 42, 0.12);
}

.cs-app__dialogBtn--confirm{
  background: linear-gradient(180deg, #0e5a73, #0b4b61);
  color: #ffffff;
}

.cs-app__dialogBtn--confirm:hover:not(:disabled){
  opacity: 0.9;
}

.cs-app__dialogBtn--danger{
  background: #dc2626;
  color: #ffffff;
}

.cs-app__dialogBtn--danger:hover:not(:disabled){
  opacity: 0.9;
}

/* Inline rename input wrapper */
.cs-app__caseItemRenameInput{
  width: 100%;
  padding: 8px 10px;
  font-size: 13px;
  border: 1px solid rgba(14, 90, 115, 0.40);
  border-radius: 6px;
  background: #ffffff;
  color: #0f172a;
  font-weight: 700;
  font-family: inherit;
  margin: 0;
}

.cs-app__caseItemRenameInput:focus{
  outline: none;
  box-shadow: 0 0 0 2px rgba(14, 90, 115, 0.20);
}
